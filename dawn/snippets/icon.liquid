stroke-linecap="round"
stroke-linejoin="round">

<path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"></path>

<path d="M12 21C12 14.5 8.5 10 4 8.5C4 15 7.5 20 12 21Z"></path>

