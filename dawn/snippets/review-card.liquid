{%- comment -%}
  Renders a review card for the marquee rail.
  Accepts:
  - block: {Object} The schema block containing review settings
{%- endcomment -%}

<article class="rcard glass-2">
  <div class="st">
    {%- for i in (1..5) -%}
      {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
    {%- endfor -%}
  </div>
  <h5>{{ block.settings.title }}</h5>
  <p>{{ block.settings.body }}</p>
  <div class="who">
    {%- if block.settings.verified -%}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    {%- endif -%}
    <span><b>{{ block.settings.reviewer_name }}</b> — {{ block.settings.product_name }}</span>
  </div>
</article>
