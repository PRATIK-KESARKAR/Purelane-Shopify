{%- comment -%}
  PURELANE: Featured Products Section (Shop Grid)
{%- endcomment -%}

<div class="sec sec-pad" id="shop">
  <div class="wrap">
    
    <div class="panel-head rv rv-d1">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2">{{ section.settings.heading }}</h2>
      <div class="rule"><i></i><i></i></div>
    </div>

    <div class="shelf">
      {%- assign collection = section.settings.collection -%}
      
      {%- if false and collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, idx: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Onboarding state if no collection selected {%- endcomment -%}
        <article class="glass card rv">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-tap" role="img" aria-label="Tap cleaner and limescale remover spray with carton"></span></div>
          <h4>Tap cleaner &amp; limescale remover</h4>
          <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
          <div class="pr"><strong>&#8377;200</strong><s>&#8377;299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
        <article class="glass card rv rv-d1">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner spray with carton"></span></div>
          <h4>Kitchen cleaner, foaming</h4>
          <div class="rate"><b>★ 4.8</b> · 254 reviews</div>
          <div class="pr"><strong>&#8377;200</strong><s>&#8377;299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
        <article class="glass card rv rv-d2">
          <div class="shot"><span class="pill">Top rated</span><span class="pimg p-metal" role="img" aria-label="Copper, bronze and brass cleaner pump bottle with carton"></span></div>
          <h4>Copper, bronze &amp; brass cleaner</h4>
          <div class="rate"><b>★ 4.8</b> · 231 reviews</div>
          <div class="pr"><strong>&#8377;200</strong><s>&#8377;299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
        <article class="glass card rv rv-d3">
          <div class="shot"><span class="pill">New</span><span class="pimg p-wm" role="img" aria-label="Washing machine cleaner and descaler tablets carton"></span></div>
          <h4>Washing machine cleaner &amp; descaler</h4>
          <div class="rate"><b>★ 4.8</b> · 183 reviews</div>
          <div class="pr"><strong>&#8377;200</strong><s>&#8377;299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}