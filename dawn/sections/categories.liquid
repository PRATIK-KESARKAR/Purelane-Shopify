{%- comment -%}
  PURELANE: Bundle Categories Section
{%- endcomment -%}

<div class="sec" id="categories">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign delay_class = '' -%}
        {%- if forloop.index0 == 1 -%}{%- assign delay_class = 'rv-d1' -%}{%- endif -%}
        {%- if forloop.index0 == 2 -%}{%- assign delay_class = 'rv-d2' -%}{%- endif -%}
        {%- if forloop.index0 == 3 -%}{%- assign delay_class = 'rv-d3' -%}{%- endif -%}
        <a class="glass cat rv {{ delay_class }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="ph"><span class="pimg {{ block.settings.image_class }}" role="img" aria-label="{{ block.settings.title }}"></span></span>
          <span class="txt">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bundle Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "image_class",
          "label": "Image Class (e.g. p-kitchen)",
          "default": "p-kitchen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        { "type": "category", "settings": { "image_class": "p-kitchen", "title": "Kitchen bundle", "text": "Grease, dishes & more", "link": "#combos" } },
        { "type": "category", "settings": { "image_class": "p-toilet", "title": "Bathroom bundle", "text": "Deep clean & disinfect", "link": "#combos" } },
        { "type": "category", "settings": { "image_class": "p-laundry", "title": "Laundry bundle", "text": "Softer, fresher wash", "link": "#combos" } },
        { "type": "category", "settings": { "image_class": "p-tap", "title": "Hard water bundle", "text": "Melt away limescale", "link": "#combos" } }
      ]
    }
  ]
}
{% endschema %}
