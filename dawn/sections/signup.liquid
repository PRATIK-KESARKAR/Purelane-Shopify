{%- comment -%}
  PURELANE: Signup Section
{%- endcomment -%}

<div class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.text }}</p>
      
      {% form 'customer', class: 'signup-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input 
          type="email" 
          name="contact[email]"
          id="NewsletterForm--{{ section.id }}"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder }}" 
          aria-label="{{ section.settings.placeholder }}" 
          required
        >
        <button class="btn btn-primary" type="submit" name="commit">{{ section.settings.button_label }}</button>
        {%- if form.posted_successfully? -%}
          <div class="form-status success" style="margin-top:12px; font-size: 14px; font-weight: 600;">Thanks for subscribing!</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-status error" style="margin-top:12px; font-size: 14px; font-weight: 600; color: #d00;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</div>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Signup",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get my ₹100 off"
    }
  ],
  "presets": [
    {
      "name": "Signup"
    }
  ]
}
{% endschema %}
