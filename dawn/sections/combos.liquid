{%- comment -%}
  PURELANE: Best-Selling Combos Section
  Block-based horizontal scroll rail.
{%- endcomment -%}

<div class="sec sec-pad" id="combos" data-scene="3">
  <div class="wrap">

    <div class="panel-head rv rv-d1">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2">{{ section.settings.heading }}</h2>
      <div class="rule"><i></i><i></i></div>
      {%- if section.settings.description != blank -%}
        <p class="lede" style="margin: 20px auto 0;">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="comborail rv rv-d2">
      {%- for block in section.blocks -%}
        <article class="glass combo {% if block.settings.badge == 'hero' %}hero-combo{% endif %}">
          <div class="tray">
            {%- if block.settings.save_label != blank -%}
              <span class="save">{{ block.settings.save_label }}</span>
            {%- endif -%}

            <div class="stack">
              {%- if block.settings.products != blank and block.settings.products.count > 0 -%}
                {%- for prod in block.settings.products limit: 4 -%}
                  {%- if forloop.index0 > 0 -%}<span class="plus" aria-hidden="true">+</span>{%- endif -%}
                  <span class="it">
                    {%- if prod.featured_image -%}
                      <img class="pimg" src="{{ prod.featured_image | image_url: width: 100 }}" alt="{{ prod.title }}" loading="lazy" width="100" height="100" style="object-fit:contain;height:66px;width:auto;margin:0 auto 8px;">
                    {%- else -%}
                      <span class="pimg p-mbtl" role="img" aria-label="{{ prod.title }}"></span>
                    {%- endif -%}
                    <span>{{ prod.title }}</span>
                  </span>
                {%- endfor -%}
              {%- else -%}
                {%- if forloop.index0 == 0 -%}
                  <span class="it"><span class="pimg p-kitchen" role="img"></span><span>Cuts grease</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-dish" role="img"></span><span>Clean dishes</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-tap" role="img"></span><span>Melts stains</span></span>
                {%- elsif forloop.index0 == 1 -%}
                  <span class="it"><span class="pimg p-laundry" role="img"></span><span>Tough stains</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-wm" role="img"></span><span>Deep cleans</span></span>
                {%- else -%}
                  <span class="it"><span class="pimg p-toilet" role="img"></span><span>Kills 99.9% germs</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-tap" role="img"></span><span>Melts stains</span></span><span class="plus" aria-hidden="true">+</span><span class="it"><span class="pimg p-eraser" role="img"></span><span>Scrubs scum</span></span>
                {%- endif -%}
              {%- endif -%}
            </div>


            <div class="pills">
              {%- if block.settings.pill_1_text != blank -%}<span class="cpill">{{ block.settings.pill_1_text }}</span>{%- endif -%}
              {%- if block.settings.pill_2_text != blank -%}<span class="cpill">{{ block.settings.pill_2_text }}</span>{%- endif -%}
              {%- if block.settings.pill_3_text != blank -%}<span class="cpill">{{ block.settings.pill_3_text }}</span>{%- endif -%}
            </div>
          </div>

          <div class="body">
            <h4>{{ block.settings.title }}</h4>
            <p class="sub">{{ block.settings.kicker }}</p>
            
            <div class="cprice">
              <strong>{{ block.settings.price }}</strong>
              {%- if block.settings.compare_price != blank -%}
                <s>{{ block.settings.compare_price }}</s>
              {%- endif -%}
            </div>

            <a href="{{ block.settings.cta_link | default: '#' }}" class="btn btn-primary">{{ block.settings.cta_label }}</a>
          </div>
        </article>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Value Combos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More clean. Less spend."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "combo_card",
      "name": "Combo Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Starter Kit"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Subtitle",
          "default": "3 bottles + 3 refills"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products to show as images",
          "limit": 3
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "Save Pill Text",
          "default": "Save ₹150"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹899"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹1,049"
        },
        {
          "type": "select",
          "id": "badge",
          "label": "Highlight Style",
          "options": [
            { "value": "none", "label": "Normal" },
            { "value": "hero", "label": "Highlighted (Gold Border)" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "pill_1_text",
          "label": "Category Pill 1",
          "default": "Multi-Surface"
        },
        {
          "type": "text",
          "id": "pill_2_text",
          "label": "Category Pill 2",
          "default": "Glass"
        },
        {
          "type": "text",
          "id": "pill_3_text",
          "label": "Category Pill 3",
          "default": "Tub & Tile"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "Add to cart"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combos",
      "blocks": [
        {
          "type": "combo_card",
          "settings": {
            "title": "Kitchen & Bath set",
            "kicker": "2 bottles + 2 refills",
            "save_label": "Save ₹150",
            "price": "₹699",
            "compare_price": "₹849",
            "badge": "hero",
            "pill_1_text": "Kitchen",
            "pill_2_text": "Bathroom"
          }
        },
        {
          "type": "combo_card",
          "settings": {
            "title": "Whole Home kit",
            "kicker": "5 bottles + 5 refills",
            "save_label": "Save ₹400",
            "price": "₹1,499",
            "compare_price": "₹1,899",
            "pill_1_text": "Kitchen",
            "pill_2_text": "Bathroom",
            "pill_3_text": "Floor"
          }
        }
      ]
    }
  ]
}
{% endschema %}
